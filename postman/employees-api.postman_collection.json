{
  "info": {
    "name": "Employees API (INVEX)",
    "description": "Every endpoint of the employees microservice, including the main error cases.\n\nBefore running, set the collection variables (Edit collection > Variables):\n- baseUrl: where the API is running, e.g. http://localhost:8080\n- username / password: the API credentials (local defaults: invex / invex-local-only)\n- employeeId: the id of an existing employee, used by the GET, PUT and DELETE requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "description": "URL where the API is running"
    },
    {
      "key": "username",
      "value": "invex",
      "description": "API user"
    },
    {
      "key": "password",
      "value": "invex-local-only",
      "description": "API password"
    },
    {
      "key": "employeeId",
      "value": "1",
      "description": "Id of an existing employee (set it after creating one)"
    }
  ],
  "item": [
    {
      "name": "1. Create",
      "item": [
        {
          "name": "Create several employees",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"firstName\": \"Juan\",\n    \"middleName\": \"Carlos\",\n    \"paternalLastName\": \"Pérez\",\n    \"maternalLastName\": \"López\",\n    \"age\": 30,\n    \"sex\": \"MALE\",\n    \"birthDate\": \"15-03-1994\",\n    \"position\": \"Backend Developer\"\n  },\n  {\n    \"firstName\": \"Ana\",\n    \"paternalLastName\": \"García\",\n    \"maternalLastName\": \"Ramírez\",\n    \"age\": 28,\n    \"sex\": \"FEMALE\",\n    \"birthDate\": \"02-07-1996\",\n    \"position\": \"QA Engineer\",\n    \"active\": true\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            }
          }
        },
        {
          "name": "Create a single employee (object, not array)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Luis\",\n  \"paternalLastName\": \"Ramírez\",\n  \"maternalLastName\": \"Soto\",\n  \"age\": 41,\n  \"sex\": \"MALE\",\n  \"birthDate\": \"20-11-1983\",\n  \"position\": \"Tech Lead\",\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            }
          }
        },
        {
          "name": "Create with invalid data (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"firstName\": \"\",\n    \"paternalLastName\": \"P3rez\",\n    \"age\": 15,\n    \"birthDate\": \"15-03-1994\",\n    \"position\": \"Dev\"\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            }
          }
        },
        {
          "name": "Create with wrong date format (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"paternalLastName\": \"Pérez\",\n  \"age\": 30,\n  \"sex\": \"MALE\",\n  \"birthDate\": \"1994-03-15\",\n  \"position\": \"Backend Developer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Read",
      "item": [
        {
          "name": "List all employees",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-Id",
                "value": "postman-list-all"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            }
          }
        },
        {
          "name": "Get employee by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Get non-existing employee (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/employees/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "999999"
              ]
            }
          }
        },
        {
          "name": "Search by name (partial)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/employees/search?name=ram",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "ram"
                }
              ]
            }
          }
        },
        {
          "name": "Search without name (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/employees/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "search"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Update",
      "item": [
        {
          "name": "Update some fields",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position\": \"Senior Backend Developer\",\n  \"age\": 31\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Update all fields",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"middleName\": \"Pablo\",\n  \"paternalLastName\": \"Pérez\",\n  \"maternalLastName\": \"Luna\",\n  \"age\": 32,\n  \"sex\": \"MALE\",\n  \"birthDate\": \"15-03-1994\",\n  \"position\": \"Tech Lead\",\n  \"active\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Update with invalid age (400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"age\": 150\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Delete",
      "item": [
        {
          "name": "Delete employee",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Delete it again (404)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Security & Health",
      "item": [
        {
          "name": "Request without credentials (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            }
          }
        },
        {
          "name": "Health check (public)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        }
      ]
    }
  ]
}